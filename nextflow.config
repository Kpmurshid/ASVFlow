nextflow.enable.dsl = 2

params {
    // Input/output
    sample_sheet = null
    outdir       = 'results'

    // Dashboard control
    enable_dashboard = false  // Set to true to launch live monitoring dashboard
    dashboard_port   = 8501   // Fixed dashboard port
    dashboard_bind_address = null // Auto-detect Tailscale, or use localhost

    // Container paths
    tools        = "$projectDir/tools"
    trim_sif     = "${params.tools}/asvflow-trim.sif"
    qc_sif       = "${params.tools}/asvflow-qc.sif"
    multiqc_sif  = "${params.tools}/asvflow-multiqc.sif"
    dada2_sif    = "${params.tools}/asvflow-dada2.sif"

    // Primer trimming configuration
    primer_mode  = 'paired'  // 'paired' or 'none'
    primer_fwd   = null      // Forward primer sequence (5' to 3')
    primer_rev   = null      // Reverse primer sequence (5' to 3')

    // Cutadapt parameters
    trim_error_rate    = 0.1
    trim_min_overlap   = 3
    trim_min_length    = 50
    discard_untrimmed  = true

    // QC parameters
    fastqc_threads = 2

    // DADA2 workflow control
    run_dada2 = true

    // DADA2 quality filtering (filterAndTrim)
    dada2_trunc_len_f   = 0        // 0 = no fixed-length truncation
    dada2_trunc_len_r   = 0        // 0 = no fixed-length truncation
    dada2_max_ee_f      = 2.0      // Maximum expected errors for R1
    dada2_max_ee_r      = 2.0      // Maximum expected errors for R2
    dada2_trunc_q       = 2        // Truncate reads at first base with quality <= Q
    dada2_max_n         = 0        // Discard reads with > N ambiguous bases
    dada2_min_len       = 50       // Minimum length after truncation
    dada2_rm_phix       = true     // Remove PhiX spike-in reads

    // DADA2 error learning
    dada2_learn_nbases  = 1000000  // Number of bases to use for error learning

    // DADA2 ASV inference
    dada2_pool          = false    // Pool samples: false, true, or 'pseudo'

    // DADA2 merging
    dada2_min_overlap   = 12       // Minimum overlap for mergePairs
    dada2_max_mismatch  = 0        // Maximum mismatches in overlap region

    // DADA2 chimera removal
    dada2_chimera_method = 'consensus'  // 'consensus', 'pooled', or 'per-sample'

    // Taxonomy assignment control
    run_taxonomy         = false        // Enable taxonomy assignment
    taxonomy_add_species = false        // Add species-level classification

    // Database paths (user-overridable)
    databases     = "$projectDir/databases"
    silva_version = "144"

    // Reference paths (null = auto-resolve, or explicit path)
    silva_genus_ref   = null
    silva_species_ref = null

    // Taxonomy algorithm parameters
    taxonomy_min_boot = 50              // Minimum bootstrap confidence (0-100)
    taxonomy_tryrc    = true            // Try reverse complement

    // Community analysis control
    run_community_analysis = false      // Enable community analysis
    sample_metadata        = null       // Path to sample metadata file (optional)
    taxonomy_table         = null       // Path to existing taxonomy TSV (optional)

    // Community analysis parameters
    composition_top_n   = 10            // Number of top taxa to display
    permanova_nperm     = 999           // Number of permutations
    permanova_seed      = 123           // Random seed for reproducibility

    // Container paths for community analysis
    stats_sif = "${params.tools}/asvflow-stats.sif"
}

// Give each invocation its own report directory, including resumed executions.
params.asvflow_invocation_id = java.util.UUID.randomUUID().toString()
params.asvflow_artifact_dir = new File(
    params.outdir,
    ".asvflow_dashboard/artifacts/${params.asvflow_invocation_id}"
).absolutePath

singularity {
    enabled    = true
    autoMounts = true
}

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 3

    withName: FASTQC {
        container = params.qc_sif
        cpus      = params.fastqc_threads
        memory    = '4.GB'
        time      = '1.h'
    }

    withName: MULTIQC {
        container = params.multiqc_sif
        cpus      = 1
        memory    = '4.GB'
        time      = '30.m'
    }

    withName: TRIM_PRIMERS {
        container = params.trim_sif
        cpus      = 4
        memory    = { 4.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withName: 'PLOT_QUALITY_PROFILE' {
        container = params.dada2_sif
        cpus      = 2
        memory    = '4.GB'
        time      = '30.m'
    }

    withName: 'FILTER_AND_TRIM|DEREPLICATE|INFER_ASVS|MERGE_PAIRS' {
        container = params.dada2_sif
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withName: LEARN_ERRORS {
        container = params.dada2_sif
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 4.h * task.attempt }
    }

    withName: 'MAKE_SEQUENCE_TABLE|REMOVE_CHIMERAS' {
        container = params.dada2_sif
        cpus      = 4
        memory    = { 12.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withName: ASSIGN_TAXONOMY {
        container = params.dada2_sif
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 4.h * task.attempt }
    }

    withName: ADD_SPECIES {
        container = params.dada2_sif
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    withName: PREPARE_INPUTS {
        container = params.stats_sif
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 30.m * task.attempt }
    }

    withName: 'ALPHA_DIVERSITY|SEQUENCING_DEPTH' {
        container = params.stats_sif
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 30.m * task.attempt }
    }

    withName: 'BETA_DIVERSITY|PERMANOVA|TAXONOMIC_COMPOSITION' {
        container = params.stats_sif
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 1.h * task.attempt }
    }
}

timeline {
    enabled = true
    file    = "${params.asvflow_artifact_dir}/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.asvflow_artifact_dir}/execution_report.html"
}

trace {
    enabled = true
    file    = "${params.asvflow_artifact_dir}/execution_trace.txt"
}
